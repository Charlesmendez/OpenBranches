{
  "name": "openbranches",
  "productName": "OpenBranches",
  "version": "0.1.0",
  "private": true,
  "description": "A local map of branches, worktrees, and the work behind them.",
  "license": "MIT",
  "author": "Carlos Mendez",
  "main": "dist-electron/main.js",
  "repository": "https://github.com/Charlesmendez/OpenBranches",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:scripts && npm run notices:check",
    "test:scripts": "node --test scripts/*.test.mjs",
    "notices:generate": "node scripts/notices.mjs --write",
    "notices:check": "node scripts/notices.mjs --check",
    "test:watch": "vitest",
    "probe:advisor": "node scripts/probe-advisor.mjs",
    "package": "npm run build && OPENBRANCHES_SIGN_RELEASE=0 electron-forge package",
    "make": "node scripts/make-macos.mjs",
    "make:arm64": "node scripts/make-macos.mjs --arch=arm64",
    "make:x64": "node scripts/make-macos.mjs --arch=x64",
    "make:release": "node scripts/make-macos.mjs --release",
    "verify:macos": "node scripts/verify-macos-artifact.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "team:install": "npm ci --prefix team-service --ignore-scripts --no-audit --no-fund",
    "team:typecheck": "tsc --noEmit --project team-service/tsconfig.json",
    "team:build": "npm run team:typecheck && node scripts/build-team.mjs",
    "team:start": "node team-service/dist/main.js",
    "test:team": "node scripts/test-team.mjs",
    "team:preview": "npm run team:build && node scripts/preview-team.mjs",
    "team:preview:mac": "node scripts/preview-team-mac.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@xyflow/react": "^12.11.6",
    "js-tiktoken": "^1.0.21",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "esbuild": "^0.28.2",
    "extract-zip": "2.0.99",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "overrides": {
    "tar": "^7.5.22",
    "tmp": "^0.2.7"
  },
  "workspaces": [
    "vendor/extract-zip"
  ]
}
