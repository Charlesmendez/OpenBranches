# Developer API preview. Copy to team-service/.env and fill the empty values.
# Use an HTTPS origin behind a proxy for access beyond this computer.
OPENBRANCHES_TEAM_ORIGIN=http://127.0.0.1:4389
OPENBRANCHES_OWNER_GITHUB_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Optional team GitHub repository flow. Keep this key outside the repository.
GITHUB_APP_PRIVATE_KEY_HOST_FILE=
# Generate a random hex password, for example: openssl rand -hex 32
POSTGRES_PASSWORD=
